{
  "name": "@runmu.sh/ext-help",
  "version": "1.0.0",
  "description": "The game's help in its own panel: topics, search, sections, cross-references and history, with F1, ?topic in Ctrl+K and Look up in Help on any word.",
  "keywords": [
    "help",
    "gmcp",
    "evennia",
    "panel",
    "documentation"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/help",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-help.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-help/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./src/types.ts",
  "files": [
    "dist",
    "schema",
    "src/types.ts",
    "README.md",
    "CHANGELOG.md",
    "screenshots"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.12.0",
    "@runmu.sh/dev": "^0.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "muclient": {
    "id": "help",
    "api": "^1.12",
    "source": "src/index.ts",
    "displayName": "Help",
    "description": "The game's help in its own panel: topics, search, sections, cross-references and history, with F1, ?topic in Ctrl+K and Look up in Help on any word.",
    "contributes": {
      "panels": [
        {
          "id": "help",
          "title": "Help"
        }
      ],
      "commands": [
        {
          "id": "help.open",
          "title": "Open help"
        },
        {
          "id": "help.lookup",
          "title": "Look up a topic"
        }
      ],
      "gmcp": [
        {
          "package": "Client.Help 1",
          "messages": {
            "Client.Help.Page": {
              "dir": "in",
              "schema": "schema/page.json"
            },
            "Client.Help.Results": {
              "dir": "in",
              "schema": "schema/page.json"
            },
            "Client.Help.Get": {
              "dir": "out",
              "schema": "schema/request.json"
            },
            "Client.Help.Search": {
              "dir": "out",
              "schema": "schema/request.json"
            },
            "Client.Help.Prefs": {
              "dir": "out",
              "schema": "schema/prefs.json"
            }
          }
        }
      ]
    },
    "capabilities": [
      "read-output",
      "send-commands"
    ],
    "categories": [
      "interface"
    ],
    "publisher": "bitmuse"
  }
}
